{
  "name": "provider-plans",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scrape": "node scripts/scrape.mjs",
    "scrape:stub": "node scripts/scrape-stub.mjs",
    "prebuild": "node scripts/generate-og.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/prerender.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:screenshots": "playwright test -c playwright.screenshots.config.ts",
    "release": "node scripts/ensure-release.mjs --all",
    "release:check": "node scripts/check-release-sync.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.100",
    "@iconify/tailwind4": "^1.2.3",
    "@opencode-ai/models": "^0.0.137",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "cheerio": "^1.2.0",
    "daisyui": "^5.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "zod": "^4.6.7"
  }
}